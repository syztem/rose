import * as THREE from 'three/webgpu';

/**
 * F06: clearcoat normal + roughness wet mix driven by hero droplet UV.
 * Canvas is a single UV-domain splat (loft uv.x=v width, uv.y=u base→tip).
 * With CanvasTexture flipY, canvas pixel maps as:
 *   x = v * size,  y = (1 - u) * size
 * Soft trails smear opposite bead (vu,vv) in that canvas space.
 * Fallback: light ambient micro-wet when no droplet system / zero active.
 */
export class WetMaps {
  constructor(_renderer, size = 512) {
    this.size = size;
    this.canvas = document.createElement('canvas');
    this.canvas.width = size;
    this.canvas.height = size;
    this.ctx = this.canvas.getContext('2d');
    this.texture = new THREE.CanvasTexture(this.canvas);
    this.texture.colorSpace = THREE.NoColorSpace;
    // Single petal UV domain — avoid Repeat seam tiling on hero glass
    this.texture.wrapS = this.texture.wrapT = THREE.ClampToEdgeWrapping;
    this.texture.needsUpdate = true;

    // Roughness wet mix (G channel used by MeshPhysicalMaterial.roughnessMap).
    // Multiplies material.roughness: wet flats lower; contact rings slightly higher.
    this.roughCanvas = document.createElement('canvas');
    this.roughCanvas.width = size;
    this.roughCanvas.height = size;
    this.roughCtx = this.roughCanvas.getContext('2d');
    this.roughnessTexture = new THREE.CanvasTexture(this.roughCanvas);
    this.roughnessTexture.colorSpace = THREE.NoColorSpace;
    this.roughnessTexture.wrapS = this.roughnessTexture.wrapT = THREE.ClampToEdgeWrapping;
    this.roughnessTexture.needsUpdate = true;

    this._frame = 0;
    /** Ambient micro-wet particles (fallback / light film only). */
    this._ambient = Array.from({ length: 28 }, () => ({
      x: Math.random(),
      y: Math.random(),
      vx: (Math.random() - 0.5) * 0.012,
      vy: -0.008 - Math.random() * 0.02,
      r: 0.003 + Math.random() * 0.006
    }));
  }

  /**
   * Map loft param (u base→tip, v width) → canvas pixel.
   * Mesh UV = (v, u); flipY → y = (1-u)*s.
   */
  _uvToCanvas(u, v) {
    const s = this.size;
    return {
      x: THREE.MathUtils.clamp(v, 0, 1) * s,
      y: (1 - THREE.MathUtils.clamp(u, 0, 1)) * s
    };
  }

  /** Paint one wet bead + optional UV-space trail at canvas (x,y). */
  _splat(x, y, rPx, trailDx, trailDy, strength = 1) {
    const ctx = this.ctx;
    const rctx = this.roughCtx;
    const r = Math.max(1.5, rPx);
    const a = strength;

    // --- clearcoat normal: bead bump + soft smear ---
    const g = ctx.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, `rgba(180,180,255,${0.85 * a})`);
    g.addColorStop(0.5, `rgba(120,140,255,${0.35 * a})`);
    g.addColorStop(1, 'rgba(128,128,255,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.ellipse(x, y, r * 1.1, r * 0.7, 0, 0, Math.PI * 2);
    ctx.fill();

    if (trailDx !== 0 || trailDy !== 0) {
      ctx.strokeStyle = `rgba(140,150,255,${0.28 * a})`;
      ctx.lineWidth = Math.max(1, r * 0.35);
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x + trailDx, y + trailDy);
      ctx.stroke();
    }

    // --- roughness wet mix ---
    // Contact ring: slight roughness up toward 1.0 multiply
    const ring = rctx.createRadialGradient(x, y, r * 0.5, x, y, r * 1.4);
    ring.addColorStop(0, 'rgba(255,255,255,0)');
    ring.addColorStop(0.5, `rgba(255,255,255,${0.55 * a})`);
    ring.addColorStop(1, 'rgba(255,255,255,0)');
    rctx.fillStyle = ring;
    rctx.beginPath();
    rctx.ellipse(x, y, r * 1.45, r * 0.98, 0, 0, Math.PI * 2);
    rctx.fill();

    // Wet flat / bead body: lower roughness
    const wet = rctx.createRadialGradient(x, y, 0, x, y, r * 0.95);
    wet.addColorStop(0, `rgba(85,85,85,${0.9 * a})`);
    wet.addColorStop(0.5, `rgba(130,130,130,${0.5 * a})`);
    wet.addColorStop(1, 'rgba(230,230,230,0)');
    rctx.fillStyle = wet;
    rctx.beginPath();
    rctx.ellipse(x, y, r * 1.05, r * 0.68, 0, 0, Math.PI * 2);
    rctx.fill();

    if (trailDx !== 0 || trailDy !== 0) {
      rctx.strokeStyle = `rgba(150,150,150,${0.32 * a})`;
      rctx.lineWidth = Math.max(1, r * 0.4);
      rctx.lineCap = 'round';
      rctx.beginPath();
      rctx.moveTo(x, y);
      rctx.lineTo(x + trailDx, y + trailDy);
      rctx.stroke();
    }
  }

  /**
   * @param {number} dt
   * @param {import('./DropletSystem.js').DropletSystem | null | undefined} dropletSystem
   */
  update(dt, dropletSystem) {
    this._frame++;
    if (this._frame % 2 !== 0) return;

    const ctx = this.ctx;
    const rctx = this.roughCtx;
    const s = this.size;

    // Normal map base (flat clearcoat normal ≈ +Z in tangent space → mid blue)
    ctx.fillStyle = '#8080ff';
    ctx.fillRect(0, 0, s, s);

    // Roughness base: slightly under 1.0 so contact rings can rise above ambient
    rctx.fillStyle = '#e6e6e6';
    rctx.fillRect(0, 0, s, s);

    const drops = dropletSystem && dropletSystem.drops;
    const active =
      dropletSystem && typeof dropletSystem.activeCount === 'number'
        ? dropletSystem.activeCount
        : drops
          ? drops.length
          : 0;

    if (drops && active > 0) {
      // Hero UV splats — wetness correlates with DropletSystem beads
      const n = Math.min(active, drops.length);
      for (let i = 0; i < n; i++) {
        const d = drops[i];
        if (!d) continue;

        const u = d.u != null ? d.u : 0.5;
        const v = d.v != null ? d.v : 0.5;
        const { x, y } = this._uvToCanvas(u, v);

        // Radius in UV → pixels (bead r is world ~0.003–0.01; map to UV blob)
        const rUv = Math.max(0.012, Math.min(0.055, (d.r || 0.005) * 4.5));
        const rPx = rUv * s;

        // UV velocity → canvas trail (behind motion).
        // x = v*s → dx = vv*s; y = (1-u)*s → dy = -vu*s
        // smear opposite velocity: trail = -vel * scale
        let trailDx = 0;
        let trailDy = 0;
        if (d.constrained) {
          const vu = d.vu || 0;
          const vv = d.vv || 0;
          const tScale = 2.8;
          trailDx = -(vv * s * tScale);
          trailDy = -(-vu * s * tScale); // = vu * s * tScale
          // Soften when nearly still
          const tLen = Math.hypot(trailDx, trailDy);
          if (tLen < 1.5) {
            trailDx = 0;
            trailDy = 0;
          } else if (tLen > rPx * 4) {
            const k = (rPx * 4) / tLen;
            trailDx *= k;
            trailDy *= k;
          }
        }

        this._splat(x, y, rPx, trailDx, trailDy, 1);
      }

      // Optional light rain film: few faint ambient streaks (does not dominate heroes)
      this._paintAmbient(dt, 0.28);
    } else {
      // No heroes — keep light ambient micro-wet so wet-without-droplets still works
      this._paintAmbient(dt, 1);
    }

    this.texture.needsUpdate = true;
    this.roughnessTexture.needsUpdate = true;
  }

  /** Drift ambient micro-dots in UV canvas space (normalized 0..1 x/y). */
  _paintAmbient(dt, strength) {
    const s = this.size;
    for (const d of this._ambient) {
      d.x += d.vx * dt * 0.9;
      d.y += d.vy * dt * 0.9;
      if (d.y < -0.05 || d.x < -0.05 || d.x > 1.05) {
        d.x = Math.random();
        d.y = 1.05;
        d.r = 0.003 + Math.random() * 0.006;
      }
      const x = d.x * s;
      const y = d.y * s;
      const r = d.r * s;
      const trailDx = -d.vx * s * 2;
      const trailDy = -d.vy * s * 2;
      this._splat(x, y, r, trailDx, trailDy, strength);
    }
  }

  bindToGlass(material) {
    material.clearcoatNormalMap = this.texture;
    // Slightly lower scale — ClampToEdge single domain, no Repeat tiling boost
    material.clearcoatNormalScale = new THREE.Vector2(0.45, 0.45);
    material.roughnessMap = this.roughnessTexture;
  }

  dispose() {
    this.texture.dispose();
    this.roughnessTexture.dispose();
  }
}
